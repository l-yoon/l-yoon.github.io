---
interface Props { name: string; tagline: string; email: string; pdf?: string; }
const { name, tagline, email, pdf } = Astro.props;
---
<header class="rise mt-12">
  <p class="kicker">Project Manager · Seoul</p>
  <h1 class="mt-5 text-5xl font-bold leading-[0.95] tracking-[-0.03em] sm:text-6xl">{name}</h1>
  <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{tagline}</p>
  <div class="no-print mt-8 flex flex-wrap items-center gap-3">
    <a
      href={`mailto:${email}`}
      class="inline-flex items-center rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-paper transition hover:opacity-90"
    >연락하기</a>
    {pdf && (
      <a
        href={pdf}
        class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium text-ink transition hover:border-accent hover:text-accent"
      >
        <span class="font-mono text-xs uppercase tracking-wider">PDF</span> 다운로드
      </a>
    )}
  </div>
</header>
