---
interface Props { name: string; tagline: string; email: string; pdf?: string; }
const { name, tagline, email, pdf } = Astro.props;
---
<header class="border-b border-[var(--color-line)] pb-10">
  <h1 class="text-4xl font-bold tracking-tight">{name}</h1>
  <p class="mt-3 text-lg text-[var(--color-muted)]">{tagline}</p>
  <div class="mt-5 flex flex-wrap items-center gap-3">
    <a href={`mailto:${email}`} class="inline-block rounded-md bg-[var(--color-accent)] px-4 py-2 text-sm font-medium text-white">연락하기</a>
    {pdf && (
      <a href={pdf} class="inline-block rounded-md border border-[var(--color-accent)] px-4 py-2 text-sm font-medium text-[var(--color-accent)]">PDF 다운로드</a>
    )}
  </div>
</header>
