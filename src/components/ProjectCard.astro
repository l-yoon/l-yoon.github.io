---
interface Props { name: string; domain: string; role: string; summary: string; }
const { name, domain, summary } = Astro.props;
---
<div class="border-t border-line py-5">
  <div class="flex items-baseline justify-between gap-3">
    <h4 class="font-semibold tracking-tight">{name}</h4>
    <span class="shrink-0 font-mono text-xs text-faint">{domain}</span>
  </div>
  <p class="mt-1.5 text-sm leading-relaxed text-muted">{summary}</p>
</div>
