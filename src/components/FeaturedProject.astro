---
interface Props {
  name: string; role: string; period: string; summary: string;
  stack: string[]; href: string;
}
const { name, role, period, summary, stack, href } = Astro.props;
---
<a
  href={href}
  class="group -mx-4 block border-t border-line px-4 py-7 transition-colors hover:bg-accent-soft/50 sm:-mx-6 sm:px-6"
>
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-2xl font-semibold tracking-tight transition-colors group-hover:text-accent">{name}</h3>
    <span class="shrink-0 font-mono text-xs text-faint">{period}</span>
  </div>
  <p class="mt-2 text-[15px] leading-relaxed text-muted">{summary}</p>
  <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-faint">
    <span>{role}</span>
    <span aria-hidden="true">·</span>
    <span class="font-mono">{stack.join(' / ')}</span>
  </div>
  <span class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider text-accent">
    View <span class="transition-transform group-hover:translate-x-1">→</span>
  </span>
</a>
