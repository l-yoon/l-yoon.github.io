---
interface Props {
  headline: { label: string; value: string }[];
  competencies: string[];
}
const { headline, competencies } = Astro.props;
---
<section class="rise mt-16 border-t border-line pt-10" style="animation-delay:0.08s">
  <dl class="grid grid-cols-3 gap-6">
    {headline.map((m) => (
      <div>
        <dt class="kicker">{m.label}</dt>
        <dd class="mt-2 text-3xl font-semibold tracking-tight text-accent sm:text-4xl">{m.value}</dd>
      </div>
    ))}
  </dl>
  <p class="mt-8 text-sm leading-relaxed text-muted">
    {competencies.join('   ·   ')}
  </p>
</section>
