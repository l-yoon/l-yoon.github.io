---
interface Props { email: string; links: { label: string; url: string }[]; }
const { email, links } = Astro.props;
---
<div class="mt-6">
  <a
    href={`mailto:${email}`}
    class="group inline-flex items-baseline gap-2 text-2xl font-semibold tracking-tight transition-colors hover:text-accent sm:text-3xl"
  >
    {email}
    <span class="font-mono text-base text-accent transition-transform group-hover:translate-x-1">→</span>
  </a>
  {links.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
      {links.map((l) => (
        <li>
          <a href={l.url} class="font-mono text-xs uppercase tracking-wider text-muted transition-colors hover:text-accent">{l.label}</a>
        </li>
      ))}
    </ul>
  )}
</div>
