---
interface Props {
  about: string;
  timeline: { period: string; org: string; role: string }[];
}
const { about, timeline } = Astro.props;
---
<div class="mt-6">
  <p class="max-w-xl whitespace-pre-line text-[15px] leading-loose text-ink/90">{about}</p>
  {timeline.length > 0 && (
    <ul class="mt-8">
      {timeline.map((t) => (
        <li class="flex gap-5 border-t border-line py-4">
          <span class="w-28 shrink-0 font-mono text-xs text-faint">{t.period}</span>
          <span class="text-sm">
            <span class="font-semibold">{t.org}</span>
            <span class="text-muted"> — {t.role}</span>
          </span>
        </li>
      ))}
    </ul>
  )}
</div>
