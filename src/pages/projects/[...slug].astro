---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => p.data.featured);
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<BaseLayout title={`${d.name} — 윤찬민`}>
  <a href="/" class="no-print inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-wider text-muted transition-colors hover:text-accent">
    ← Portfolio
  </a>

  <header class="rise mt-8 border-b border-line pb-8">
    <p class="kicker">{d.domain}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{d.name}</h1>
    <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-faint">
      <span>{d.role}</span><span aria-hidden="true">·</span>
      <span>{d.period}</span><span aria-hidden="true">·</span>
      <span>{d.team}</span>
    </div>
    <div class="mt-2 font-mono text-xs text-faint">{d.stack.join(' / ')}</div>
    {d.metrics.length > 0 && (
      <dl class="mt-6 flex flex-wrap gap-x-10 gap-y-4">
        {d.metrics.map((m) => (
          <div>
            <dt class="kicker">{m.label}</dt>
            <dd class="mt-1 text-2xl font-semibold tracking-tight text-accent">{m.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </header>

  <article class="rise mt-10 [&_h2]:mt-9 [&_h2]:text-sm [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-accent [&_p]:mt-3 [&_p]:leading-relaxed [&_p]:text-muted [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-5 [&_li]:leading-relaxed [&_li]:text-muted" style="animation-delay:0.08s">
    <Content />
  </article>

  <a href="/" class="no-print mt-12 inline-flex items-center gap-1.5 border-t border-line pt-6 font-mono text-xs uppercase tracking-wider text-muted transition-colors hover:text-accent">
    ← 포트폴리오로 돌아가기
  </a>
</BaseLayout>
